# ─────────────────────────────────────────────────────────────────────────────
# ChainWatch — Environment Configuration
#
# Copy this file to .env and fill in values before starting the application.
#
#   Local dev (Start.sh):
#     NEO4J_URI=bolt://localhost:7687
#
#   Docker Compose:
#     NEO4J_URI is OVERRIDDEN to bolt://neo4j:7687 by docker-compose.yml.
#     You do not need to change it here for Docker deployments.
#
# .env is in .gitignore — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j connection ──────────────────────────────────────────────────────────
# Local dev: bolt://localhost:7687
# Docker:    overridden to bolt://neo4j:7687 by docker-compose.yml environment:
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=chainwatch2026
NEO4J_DATABASE=neo4j

# ── Broadcast IP correlation engine ──────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=30
CORRELATION_TAU=8.0

# ── Investigation / graph limits ─────────────────────────────────────────────
MAX_INVESTIGATION_HOPS=5
MAX_GRAPH_NODES=500
MAX_GRAPH_EDGES=1000
MAX_PAGE_SIZE=100
MAX_GRAPH_TRANSACTIONS=15000

# ── API security ─────────────────────────────────────────────────────────────
# Required on POST /ingest, POST /clear, DELETE /clear (X-API-Key header).
# Change this before any deployment accessible beyond localhost.
API_KEY=chainwatch-local

# ── Ingest limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800

# ── Runtime environment ───────────────────────────────────────────────────────
# dev | prod
ENV=dev

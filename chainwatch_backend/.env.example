# ── Neo4j connection ──────────────────────────────────────────────────────────
# For local docker-compose Neo4j (docker-compose.yml in repo root):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackathon2026
NEO4J_DATABASE=neo4j

# For Neo4j Aura cloud instance (comment out the above and use these):
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=xxxxxxxx
# NEO4J_PASSWORD=your_aura_password_here
# NEO4J_DATABASE=xxxxxxxx

# ── Broadcast IP correlation engine ──────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=30
CORRELATION_TAU=8.0

ENV=dev

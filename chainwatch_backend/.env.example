# Copy this file to .env and fill in values.
# ChainWatch uses local docker-compose Neo4j — no cloud account needed.

# ── Neo4j (docker-compose.yml in repo root) ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackathon2026
NEO4J_DATABASE=neo4j

# ── Broadcast IP correlation engine ──────────────────────────────────────────
CORRELATION_WINDOW_SECONDS=30
CORRELATION_TAU=8.0

# ── Investigation / graph limits ─────────────────────────────────────────────
MAX_INVESTIGATION_HOPS=5
MAX_GRAPH_NODES=500
MAX_GRAPH_EDGES=1000
MAX_PAGE_SIZE=100

# ── API security ─────────────────────────────────────────────────────────────
API_KEY=chainwatch-local

# ── Ingest limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800

ENV=dev

# Neo4j Database Connection (Local bolt://localhost:7687 or Cloud neo4j+s://...)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Aura Cloud Instance Metadata (Optional)
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=chainwatch-transactions

# Broadcast IP Correlation Engine Parameters
CORRELATION_WINDOW_SECONDS=30
CORRELATION_TAU=8.0
ENV=dev
